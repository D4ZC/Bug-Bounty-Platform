# Configuración de la API
VITE_API_URL=http://localhost:3001

# Configuración de WebSocket (opcional)
VITE_WS_URL=ws://localhost:3002

# Configuración de la aplicación
VITE_APP_NAME=Bug Bounty Platform
VITE_APP_VERSION=1.0.0

# Authentication
VITE_AUTH_DOMAIN=your-auth-domain.auth0.com
VITE_AUTH_CLIENT_ID=your-auth-client-id

# External Services
VITE_MENDSCAN_API_URL=https://api.mend.io
VITE_MENDSCAN_API_KEY=your-mendscan-api-key

# Analytics (Optional)
VITE_GA_TRACKING_ID=your-ga-tracking-id
VITE_SENTRY_DSN=your-sentry-dsn

# Feature Flags
VITE_ENABLE_GULAG=true
VITE_ENABLE_MVP=true
VITE_ENABLE_SHOP=true
VITE_ENABLE_CONTRIBUTIONS=true

# Development
VITE_DEBUG=true
VITE_LOG_LEVEL=debug 